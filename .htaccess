<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Pastikan server mengutamakan file hasil build di dist/
  DirectoryIndex dist/index.html index.php index.html

  # 2. Rewrite langsung request root ('/') dan '/index.html' ke dist/index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 3. Request ke /assets/... diarahkan ke dist/assets/...
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Jika file/folder fisik memang ada di root (selain index.html dan selain /src/), sajikan langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/src/
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteRule ^ - [L]

  # 5. Routing Single Page Application (SPA): semua request lain dialihkan ke dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . dist/index.html [L]

  # 6. Fallback jika dist belum terbaca
  RewriteCond %{DOCUMENT_ROOT}/index.php -f
  RewriteRule . index.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "index\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
